{
  "title": "Valheim Resource Reference",
  "description": "Resources grouped by natural origin for storage and gathering. Some sources and newer items require in-game verification.",
  "wikiBaseUrl": "https://valheim.weirdgloop.org/wiki/",
  "implementation": {
    "summary": "Create a reusable ResourceReferenceTrigger that opens a shadcn/ui Drawer from the bottom. Inside DrawerContent, render an Accordion with one section per category (General first, then biomes). Each expanded section displays a compact resource table or responsive list: resource name linking to its wiki page, source, and gathering tip. Use a scrollable content area and keep the drawer accessible on mobile. Place the trigger wherever a 'Resource Reference' link is needed.",
    "components": [
      "Drawer",
      "DrawerTrigger",
      "DrawerContent",
      "DrawerHeader",
      "DrawerTitle",
      "Accordion",
      "AccordionItem",
      "AccordionTrigger",
      "AccordionContent",
      "ScrollArea"
    ],
    "triggerLabel": "Resource Reference",
    "suggestedFile": "src/data/valheim-resources.json"
  },
